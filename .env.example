# ============================================================================
# KingdomTradex — Environment Variables
# Copy this file to .env.local and fill in all values.
# ============================================================================

# === CRITICAL (required for app to function) ===

# Supabase project URL (e.g. https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (from Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (from Project Settings > API — KEEP SECRET)
SUPABASE_SERVICE_ROLE_KEY=

# Secret used by Vercel cron jobs and share token signing
# Generate: openssl rand -hex 32
CRON_SECRET=

# NOWPayments API key (from NOWPayments dashboard > API Keys)
NOWPAYMENTS_API_KEY=

# NOWPayments IPN secret (from NOWPayments dashboard > IPN Settings)
NOWPAYMENTS_IPN_SECRET=

# Resend API key (from resend.com > API Keys)
RESEND_API_KEY=

# Public app URL (used for email links, IPN callbacks, redirects)
NEXT_PUBLIC_APP_URL=https://kingdomtradex.vercel.app

# === CUSTODY OPERATIONS (NOWPayments Custody API) ===

# NOWPayments account email (for custody/auth endpoint)
NOWPAYMENTS_EMAIL=

# NOWPayments account password (for custody/auth endpoint)
NOWPAYMENTS_PASSWORD=

# XMR cold wallet address for auto-split deposits
COLD_WALLET_XMR=

# === OPTIONAL ===

# OpenRouter API key (for AI Oracle chatbot)
OPENROUTER_API_KEY=

# OpenRouter model (default: openai/gpt-4o-mini)
# OPENROUTER_MODEL=deepseek-v4-flash

# Launch date for countdown timer (ISO format)
# NEXT_PUBLIC_LAUNCH_DATE=2025-01-01T00:00:00Z

# Tawk.to live chat widget
# NEXT_PUBLIC_TAWKTO_PROPERTY_ID=
# NEXT_PUBLIC_TAWKTO_WIDGET_ID=

# Plisio API key (deprecated — NOWPayments is authoritative)
# PLISIO_API_KEY=
